{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xw-music",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "xw-music"
    }
  ],
  "observability": {
    "enabled": true
  }
}
